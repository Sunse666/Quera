<Window x:Class="Quera.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Quera"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Width="680" SizeToContent="Height">

    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="Chrome" GlassFrameThickness="0"
                      CornerRadius="20" ResizeBorderThickness="0"
                      CaptionHeight="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="OuterBorder" Background="#B216213E" CornerRadius="20">

        <Grid x:Name="OuterGrid" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="SearchCard" Grid.Row="0"
                    Background="#0DFFFFFF" BorderBrush="#12FFFFFF"
                    BorderThickness="1" CornerRadius="14" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SearchIcon" Grid.Column="0" Text="🔍"
                               FontSize="17" FontFamily="Segoe UI Emoji" Opacity="0.5"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBox x:Name="SearchTextBox" Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#FFFFFF" FontSize="17"
                             CaretBrush="#D97035" VerticalAlignment="Center"
                             FontFamily="Microsoft YaHei UI"/>

                    <Border x:Name="EscBadge" Grid.Column="2" Background="#12FFFFFF"
                            CornerRadius="5" Padding="7,3" VerticalAlignment="Center">
                        <TextBlock x:Name="EscText" Text="ESC 关闭"
                                   Foreground="#667788" FontSize="10"/>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="ResultsCard" Grid.Row="1"
                    Background="#CC1A1A2E" BorderBrush="#33FFFFFF"
                    BorderThickness="1" CornerRadius="14" Padding="6"
                    Margin="0,10,0,0"
                    Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}">

                <ListView x:Name="ResultsListView"
                          ItemsSource="{Binding Results}"
                          SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="10,7"
                                    Background="#18FFFFFF" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentControl x:Name="IconCtrl" Grid.Column="0"
                                                    Content="{Binding Icon, Converter={StaticResource IconToImage}}"
                                                    Width="20" Height="20"
                                                    VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="ResultName" Text="{Binding Name}"
                                                   Foreground="White" FontSize="14"/>
                                        <TextBlock x:Name="ResultDesc" Text="{Binding Description}"
                                                   Foreground="#8899AA" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border x:Name="Badge" Grid.Column="2" Background="#12FFFFFF"
                                            CornerRadius="3" Padding="5,2">
                                        <TextBlock Text="{Binding Type, Converter={StaticResource TypeToBadgeText}}"
                                                   Foreground="#8899AA" FontSize="9"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border x:Name="StatusBar" Grid.Row="2" Padding="8,8,8,4" Margin="0,4,0,0"
                    Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock x:Name="StatusLeft" DockPanel.Dock="Left"
                               Foreground="#556677" FontSize="10">
                        <Run Text="↑↓ 导航"/><Run Text="  "/>
                        <Run Text="Enter 执行"/><Run Text="  "/>
                        <Run Text="Ctrl+, 配置"/>
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                               Foreground="#556677" FontSize="10"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
