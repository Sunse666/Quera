//console.open();

//配置解析模块
namespace appconfig {
	var configPath = ..io.fullpath("/config.ini");
	var data = {};
	
	//去除引号和首尾空格
	var clean = function(s) {
		if (!s) return "";
		s = ..string.trim(s);
		var len = #s;
		if (len >= 2) {
			var first = ..string.left(s, 1);
			var last = ..string.right(s, 1);
			if ((first == '"' && last == '"') || (first == "'" && last == "'")) {
				return ..string.sub(s, 2, len - 1);
			}
		}
		return s;
	};
	
	//解析配置文件
	parse = function() {
		//默认配置
		data = {
			hotkey = "Alt+Space";
			width = 680;
			height = 480;
			opacity = 95;
			max_results = 30;
			autostart = false;
			search_paths = {};
			file_types = { ".exe"; ".lnk" };
			web_search = {};
			commands = {};
			folders = {};
			bookmarks = {};
			
			//优先级配置
			priority = {
				types = { "command"; "bookmark"; "file"; "folder"; "search"; "search_hint" };
				extensions = { ".exe"; ".lnk"; ".bat"; ".ps1" };
				custom_path_first = true;
			};
		};
		
		//读取文件
		var file = ..io.open(configPath, "r");
		if (!file) {
			//..console.log("配置文件不存在: " ++ configPath);
			return data;
		}
		
		var text = file.read(-1);
		file.close();
		
		if (!text || #text == 0) {
			//..console.log("配置文件为空");
			return data;
		}
		
		//处理BOM
		if (..string.startWith(text, '\xEF\xBB\xBF')) {
			text = ..string.sub(text, 4);
		}
		
		//统一换行符
		text = ..string.replace(text, "\r\n", "\n");
		text = ..string.replace(text, "\r", "\n");
		
		var currentSection = null;
		var currentItem = null;
		var lines = ..string.split(text, '\n');
		
		//解析filetype时清空默认值
		var fileTypeCleared = false;
		
		for (i, line in lines) {
			line = ..string.trim(line);
			
			//跳过空行和注释
			if (#line == 0) continue;
			if (..string.left(line, 1) == "#") continue;
			if (..string.left(line, 1) == ";") continue;
			
			//检查section [xxx]
			if (..string.left(line, 1) == "[" && ..string.right(line, 1) == "]") {
				//提取中间内容
				var section = ..string.sub(line, 2, #line - 1);
				section = ..string.trim(section);
				section = ..string.lower(section);
				
				//..console.log("  发现 section: [" ++ section ++ "]");
				
				//保存上一个item
				currentItem = null;
				
				//创建新item
				if (section == "command") {
					currentItem = {};
					..table.push(data.commands, currentItem);
					currentSection = "command";
				}
				elseif (section == "folder") {
					currentItem = {};
					..table.push(data.folders, currentItem);
					currentSection = "folder";
				}
				elseif (section == "bookmark") {
					currentItem = {};
					..table.push(data.bookmarks, currentItem);
					currentSection = "bookmark";
				}
				elseif (section == "search") {
					currentItem = {};
					..table.push(data.web_search, currentItem);
					currentSection = "search";
				}
				elseif (section == "filetype") {
					//清空默认文件类型
					if (!fileTypeCleared) {
						data.file_types = {};
						fileTypeCleared = true;
					}
					currentSection = "filetype";
				}
				else {
					currentSection = section;
				}
				continue;
			}
			
			//对于path和filetype，直接作为简单值处理
			if (currentSection == "path") {
				var path = clean(line);
				if (#path > 0) {
					..table.push(data.search_paths, path);
					//..console.log("	添加路径: " ++ path);
				}
				continue;
			}
			
			if (currentSection == "filetype") {
				var ext = clean(line);
				if (#ext > 0) {
					if (!..string.startWith(ext, ".")) {
						ext = "." ++ ext;
					}
					..table.push(data.file_types, ext);
					//..console.log("	添加类型: " ++ ext);
				}
				continue;
			}
			
			//检查key=value
			var eqPos = ..string.find(line, "=");
			if (eqPos) {
				var key = ..string.trim(..string.sub(line, 1, eqPos - 1));
				var value = ..string.trim(..string.sub(line, eqPos + 1));
				
				if (key && #key > 0) {
					value = clean(value);
					key = ..string.lower(key);
					
					//根据当前section处理
					if (currentSection == "settings") {
						if (key == "hotkey") {
							data.hotkey = value;
						} elseif (key == "width") {
							data.width = tonumber(value) || 680;
						} elseif (key == "height") {
							data.height = tonumber(value) || 480;
						} elseif (key == "opacity") {
							data.opacity = tonumber(value) || 95;
						} elseif (key == "max_results") {
							data.max_results = tonumber(value) || 30;
						} elseif (key == "autostart") {
							data.autostart = (value == "true");
						}
					}
					elseif (currentSection == "priority") {
						if (key == "types") {
							data.priority.types = {};
							var items = ..string.split(value, ",");
							for (_, item in items) {
								item = ..string.trim(item);
								if (#item > 0) {
									..table.push(data.priority.types, item);
								}
							}
						}
						elseif (key == "extensions") {
							data.priority.extensions = {};
							var items = ..string.split(value, ",");
							for (_, item in items) {
								item = ..string.trim(item);
								if (#item > 0) {
									if (!..string.startWith(item, ".")) {
										item = "." ++ item;
									}
									..table.push(data.priority.extensions, item);
								}
							}
						}
						elseif (key == "custom_path_first") {
							data.priority.custom_path_first = (value == "true");
						}
					}
					elseif (currentItem) {
						//command/folder/bookmark/search的属性
						if (value == "true") {
							currentItem[key] = true;
						} elseif (value == "false") {
							currentItem[key] = false;
						} else {
							currentItem[key] = value;
						}
					}
				}
			}
		}
		
		//..console.log("配置加载完成");
		//..console.log("  热键: " ++ data.hotkey);
		//..console.log("  搜索路径: " ++ #data.search_paths);
		//..console.log("  文件类型: " ++ #data.file_types);
		//..console.log("  命令: " ++ #data.commands);
		//..console.log("  文件夹: " ++ #data.folders);
		//..console.log("  书签: " ++ #data.bookmarks);
		//..console.log("  搜索引擎: " ++ #data.web_search);
		
		for (i, engine in data.web_search) {
			//..console.log("  搜索引擎 " ++ i ++ ": keyword=" ++ (engine.keyword || "无") ++ ", url=" ++ (engine.url || "无"));
		}
		return data;
	};
	
	get = function() {
		return data;
	};
	
	expandPath = function(path) {
		if (!path) return "";
		
		//用户目录
		if (..string.startWith(path, "~")) {
			return ..io.getSpecial(0x28) ++ ..string.sub(path, 2);
		}
		
		//绝对路径
		if (..string.find(path, ":") || ..string.startWith(path, "\\\\")) {
			return path;
		}
		
		//相对路径
		return ..io.fullpath("/" ++ path);
	};
}

//搜索模块
namespace searcher {
	var fileCache = {};
	var cacheBuilt = false;
	
	//构建文件索引
	buildCache = function(paths, types) {
		fileCache = {};
		
		var typeSet = {};
		for (_, t in types) {
			var ext = ..string.lower(t);
			if (!..string.startWith(ext, ".")) {
				ext = "." ++ ext;
			}
			typeSet[ext] = true;
		}
		
		//自定义搜索路径
		for (_, searchPath in paths) {
			var fullPath = ..appconfig.expandPath(searchPath);
			if (..io.exist(fullPath)) {
				..fsys.enum(fullPath, "/*", function(dir, name, fullpath, findData) {
					if (!name) return;
					
					var ext = ..string.lower(..fsys.getExtensionName(name) || "");
					if (!..string.startWith(ext, ".")) {
						ext = "." ++ ext;
					}
					
					if (typeSet[ext]) {
						..table.push(fileCache, {
							name = ..fsys.getFileName(name, true);
							fullName = name;
							path = fullpath;
							ext = ext;
							type = "file";
							icon = getFileIcon(ext);
							source = "custom";
						});
					}
				}, true);
			}
		}
		
		//开始菜单程序
		var startMenuPaths = {
			..io.getSpecial(0x2);
			..io.getSpecial(0x17);
		};
		
		for (_, menuPath in startMenuPaths) {
			if (menuPath && ..io.exist(menuPath)) {
				..fsys.enum(menuPath, "/*.lnk", function(dir, name, fullpath) {
					if (!name) return;
					..table.push(fileCache, {
						name = ..fsys.getFileName(name, true);
						fullName = name;
						path = fullpath;
						ext = ".lnk";
						type = "app";
						icon = "🔗";
						source = "startmenu";
					});
				}, true);
			}
		}
		
		cacheBuilt = true;
		//..console.log("缓存构建完成，文件数量: " ++ #fileCache);
	};
	
	getFileIcon = function(ext) {
		ext = ..string.lower(ext);
		if (..string.startWith(ext, ".")) {
			ext = ..string.sub(ext, 2);
		}
		var icons = {
			exe = "📦"; lnk = "🔗"; bat = "📜"; ps1 = "⚡";
			txt = "📄"; pdf = "📕"; png = "🖼️"; jpg = "🖼️";
		};
		return icons[ext] || "📄";
	};
	
	processIconPath = function(iconValue) {
		if (!iconValue) return "";
		
		var iconStr = tostring(iconValue);
		var lower = ..string.lower(iconStr);
		
		if (..string.endWith(lower, ".ico") || ..string.endWith(lower, ".png") || 
			..string.endWith(lower, ".jpg") || ..string.endWith(lower, ".jpeg")) {
			
			var fullPath = ..appconfig.expandPath(iconStr);
			
			if (..io.exist(fullPath)) {
				var data = ..string.load(fullPath);
				if (data) {
					var ext = ..string.lower(..fsys.getExtensionName(fullPath));
					var mimeType = "image/png";
					if (ext == ".ico") mimeType = "image/x-icon";
					elseif (ext == ".jpg" || ext == ".jpeg") mimeType = "image/jpeg";
					
					var base64 = ..crypt.bin.encodeBase64(data);
					return "data:" ++ mimeType ++ ";base64," ++ base64;
				}
			}
		}
		return iconStr;
	};

	//匹配函数
	var isMatch = function(text, query) {
		if (!text || !query) return false;
		
		//确保转为字符串并转小写
		text = ..string.lower(tostring(text) : "");
		query = ..string.lower(tostring(query) : "");
		
		if (#text == 0 || #query == 0) return false;
		
		//使用string.indexOf进行子字符串查找
		var pos = ..string.indexOf(text, query);
		return pos != null && pos > 0;
	};
	
	//搜索
	search = function(query, cfg, maxResults) {
		var results = {};
		query = ..string.lower(..string.trim(query));
		if (#query == 0) return results, 0;
		
		//..console.log("搜索关键词: " ++ query);
		
		//检查搜索引擎关键词触发
		var spacePos = ..string.indexOf(query, " ");
		if (spacePos) {
			var keyword = ..string.sub(query, 1, spacePos - 1);
			var searchQuery = ..string.trim(..string.sub(query, spacePos + 1));
			
			if (#keyword > 0 && #searchQuery > 0) {
				for (_, engine in cfg.web_search) {
					if (..string.lower(engine.keyword || "") == keyword) {
						var url = ..string.replace(engine.url || "", "{query}", searchQuery);
						..table.push(results, {
							name = (engine.name || "搜索") ++ ": " ++ searchQuery;
							description = url;
							type = "web_search";
							icon = engine.icon || "🔍";
							url = url;
						});
						return results;
					}
				}
			}
		}
		
		//搜索命令
		for (_, cmd in cfg.commands) {
			if (isMatch(cmd.keyword, query) || isMatch(cmd.name, query)) {
				..table.push(results, {
					name = cmd.name || "";
					description = cmd.keyword || "";
					type = "command";
					icon = cmd.icon || "⚡";
					action = cmd.action || "";
					admin = cmd.admin;
					sortOrder = 2;
				});
			}
		}
		
		//搜索书签
		for (_, bookmark in cfg.bookmarks) {
			if (isMatch(bookmark.keyword, query) || isMatch(bookmark.name, query)) {
				..table.push(results, {
					name = bookmark.name || "";
					description = bookmark.url || "";
					type = "bookmark";
					icon = bookmark.icon || "🔗";
					url = bookmark.url || "";
					sortOrder = 4;
				});
			}
		}
		
		//搜索文件缓存
		for (_, file in fileCache) {
			if (isMatch(file.name, query) || isMatch(file.fullName, query)) {
				//计算排序优先级
				var order = 3;
				if (file.source == "custom") {
					order = 1;  //自定义目录最优先
				}
				
				//扩展名子排序
				var extOrder = 99;
				if (file.ext == ".exe") extOrder = 1;
				elseif (file.ext == ".lnk") extOrder = 2;
				
				..table.push(results, {
					name = file.name || "";
					description = file.path || "";
					type = file.type || "file";
					icon = file.icon || "📄";
					path = file.path || "";
					ext = file.ext || "";
					source = file.source || "";
					sortOrder = order;
					extOrder = extOrder;
				});
			}
		}
		
		//搜索文件夹
		for (_, folder in cfg.folders) {
			if (isMatch(folder.keyword, query) || isMatch(folder.name, query)) {
				var path = ..appconfig.expandPath(folder.path || "");
				..table.push(results, {
					name = folder.name || "";
					description = path;
					type = "folder";
					icon = folder.icon || "📁";
					path = path;
					sortOrder = 5;
				});
			}
		}
		
		//搜索引擎提示
		for (_, engine in cfg.web_search) {
			if (isMatch(engine.keyword, query) || isMatch(engine.name, query)) {
				..table.push(results, {
					name = engine.name || "";
					description = '输入 "' ++ (engine.keyword || "") ++ ' 关键词" 进行搜索';
					type = "search_hint";
					icon = engine.icon || "🔍";
					keyword = engine.keyword || "";
					sortOrder = 6;
				});
			}
		}
		
		//..console.log("搜索结果数量: " ++ #results);
		
		var totalCount = #results;
		maxResults = maxResults || 30;
		if (#results > maxResults) {
			var limited = {};
			for (i = 1; maxResults) {
				..table.push(limited, results[i]);
			}
			results = limited;
		}
		
		for (i, item in results) {
			if (item.icon) {
				item.icon = processIconPath(item.icon);
			}
		}
		
		//..console.log("返回结果数量: " ++ #results);
		
		return results, totalCount;
	};
}

//执行模块
namespace executor {
	run = function(item) {
		if (!item || !item.type) return null;
		
		select (item.type) {
			case "command" {
				var action = item.action || "";
				
				if (..string.startWith(action, "shell:")) {
					var target = ..string.sub(action, 7);
					if (item.admin) {
						..process.runas("explorer.exe", target);
					} else {
						..process.execute("explorer.exe", target);
					}
				} 
				elseif (..string.startWith(action, "cmd:")) {
					var cmd = ..string.sub(action, 5);
					if (item.admin) {
						..process.runas("cmd.exe", "/c " ++ cmd);
					} else {
						..process.execute("cmd.exe", "/c " ++ cmd);
					}
				}
				elseif (..string.startWith(action, "ps:")) {
					var cmd = ..string.sub(action, 4);
					if (item.admin) {
						..process.runas("powershell.exe", "-Command " ++ cmd);
					} else {
						..process.execute("powershell.exe", "-Command " ++ cmd);
					}
				}
				elseif (..string.startWith(action, "run:")) {
					var program = ..string.sub(action, 5);
					if (item.admin) {
						..process.runas(program);
					} else {
						..process.execute(program);
					}
				}
			}
			case "file", "app" {
				if (item.path) {
					..process.execute(item.path);
				}
			}
			case "folder" {
				if (item.path) {
					..process.execute("explorer.exe", item.path);
				}
			}
			case "bookmark", "web_search" {
				//..console.log("打开URL: " ++ (item.url || "空"));
				if (item.url) {
					..process.execute(item.url);
				}
			}
			case "search_hint" {
				return (item.keyword || "") ++ " ";
			}
		}
		return null;
	};
}

//UI
import win.region.round;
win.region.round(mainForm);

//mainForm.transparent(true);

var cfg = appconfig.parse();

if (cfg.autostart) {
	sys.run("Quera").register("/silent");
} else {
	sys.run("Quera").delete();
}

var appearance = { 
	width = cfg.width || 680; 
	height = cfg.height || 480; 
	opacity = cfg.opacity || 95 
};

mainForm.enableDpiScaling();

import fsys.knownFolder;
var dataPath = fsys.joinpath(fsys.knownFolder("{F1B32785-6FBA-4FCF-9D55-7B8E7F157091}"), "Talina");

var wb = web.view(mainForm,{
	extensions = false;
	userDataDir = dataPath;
})

wb.defaultBackgroundColor = 0x00FFFFFF;

mainForm.setPos(0, 0, appearance.width, appearance.height);

//暴露函数给JavaScript
wb.external = {
	search = function(query) {
		var results, totalCount = searcher.search(query, cfg, cfg.max_results);
		
		var jsonStr;
		try {
			//包装成带总数的对象
			var response = {
				total = totalCount;
				displayed = #results;
				items = results;
			};
			jsonStr = web.json.stringify(response);
		} catch(e) {
			return '{"total":0,"displayed":0,"items":[]}';
		}
		
		if (!jsonStr || #jsonStr == 0) {
			return '{"total":0,"displayed":0,"items":[]}';
		}
		
		return jsonStr;
	};

	execute = function(itemJson) {
		var item = web.json.parse(itemJson);
		if (!item) return "";
		var result = executor.run(item);
		return result || "";
	};
	
	hide = function() {
		mainForm.show(false);
		return "";
	};
	
	openConfig = function() {
		..process.execute("notepad.exe", ..io.fullpath("/config.ini"));
		return "";
	};
	
	reloadConfig = function() {
		cfg = appconfig.parse();
		searcher.buildCache(cfg.search_paths, cfg.file_types);
		return "ok";
	};
	
	debug = function(msg) {
		//..console.log("[JS] " ++ msg);
		return "";
	};
};

wb.html = /**
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }

::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #3a3a3a; border-radius: 3px; }

body {
	font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
	background: rgba(22, 33, 62, 0.65);
	backdrop-filter: blur(20px);
	-webkit-backdrop-filter: blur(20px);
	color: #fff;
	height: 100vh;
	overflow: hidden;
	user-select: none;
}

.container {
	padding: 16px;
	height: 100%;
	display: flex;
	flex-direction: column;
}

.search-bar {
	display: flex;
	align-items: center;
	background: rgba(255,255,255,0.08);
	border: 1px solid rgba(255,255,255,0.1);
	border-radius: 12px;
	padding: 12px 16px;
	margin-bottom: 12px;
}

.search-bar:focus-within {
	border-color: #d97035;
	box-shadow: 0 0 0 3px rgba(217,112,53,0.2);
}

.search-icon { font-size: 20px; margin-right: 12px; opacity: 0.6; }

.search-input {
	flex: 1;
	background: transparent;
	border: none;
	outline: none;
	font-size: 18px;
	color: #fff;
}

.search-input::placeholder { color: rgba(255,255,255,0.4); }

.shortcut-hint {
	font-size: 11px;
	color: rgba(255,255,255,0.3);
	background: rgba(255,255,255,0.1);
	padding: 4px 8px;
	border-radius: 6px;
}

.results {
	flex: 1;
	overflow-y: auto;
	padding-right: 4px;
}

.result-item {
	display: flex;
	align-items: center;
	padding: 12px 16px;
	border-radius: 10px;
	cursor: pointer;
	margin-bottom: 4px;
	transition: all 0.15s ease;
}

.result-item:hover { background: rgba(255,255,255,0.06); }
.result-item.selected { 
	background: linear-gradient(135deg, #d97035 0%, #e8955a 100%); 
}

.result-icon { font-size: 28px; margin-right: 14px; width: 36px; text-align: center; }

.result-content { flex: 1; min-width: 0; }

.result-name {
	font-size: 15px;
	font-weight: 500;
	margin-bottom: 2px;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.result-desc {
	font-size: 12px;
	color: rgba(255,255,255,0.5);
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.result-item.selected .result-desc { color: rgba(255,255,255,0.7); }

.result-badge {
	font-size: 10px;
	padding: 3px 8px;
	border-radius: 4px;
	background: rgba(255,255,255,0.1);
	color: rgba(255,255,255,0.6);
}

.status-bar {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 10px 8px;
	border-top: 1px solid rgba(255,255,255,0.08);
	font-size: 11px;
	color: rgba(255,255,255,0.4);
}

.status-keys { display: flex; gap: 16px; }
.status-key { display: flex; align-items: center; gap: 4px; }
.key-badge {
	background: rgba(255,255,255,0.1);
	padding: 2px 6px;
	border-radius: 4px;
	font-family: monospace;
}

.empty-state {
	text-align: center;
	padding: 60px 20px;
	color: rgba(255,255,255,0.4);
}

.empty-icon { font-size: 48px; margin-bottom: 16px; opacity: 0.5; }

.empty-tips {
	margin-top: 20px;
	font-size: 12px;
	line-height: 2;
}

.empty-tips code {
	background: rgba(255,255,255,0.1);
	padding: 2px 8px;
	border-radius: 4px;
}
</style>
</head>
<body>

<div class="container">
	<div class="search-bar">
		<span class="search-icon">🔍</span>
		<input type="text" class="search-input" id="searchInput" 
			   placeholder="搜索应用、文件、命令...">
		<span class="shortcut-hint">ESC 关闭</span>
	</div>
	
	<div class="results" id="results"></div>
	
	<div class="status-bar">
		<div class="status-keys">
			<span class="status-key"><span class="key-badge">↑↓</span> 导航</span>
			<span class="status-key"><span class="key-badge">Enter</span> 执行</span>
			<span class="status-key"><span class="key-badge">Ctrl+,</span> 配置</span>
		</div>
		<span id="statusText">就绪</span>
	</div>
</div>

<script>
const input = document.getElementById('searchInput');
const resultsDiv = document.getElementById('results');
const statusText = document.getElementById('statusText');

let results = [];
let totalCount = 0;
let selectedIndex = 0;
let searchTimer = null;

const typeNames = {
	command: '命令',
	file: '文件',
	app: '应用',
	folder: '文件夹',
	bookmark: '书签',
	web_search: '搜索',
	search_hint: '搜索引擎'
};

function escapeHtml(text) {
	if (!text) return '';
	const div = document.createElement('div');
	div.textContent = String(text);
	return div.innerHTML;
}

function renderIcon(icon) {
	if (!icon) return '📄';
	if (icon.startsWith('data:image/')) {
		return '<img src="' + icon + '" style="width:24px;height:24px;object-fit:contain;vertical-align:middle;">';
	}
	return escapeHtml(icon);
}

function renderResults() {
	if (results.length === 0) {
		if (input.value.trim()) {
			resultsDiv.innerHTML = '<div class="empty-state"><div class="empty-icon">🔎</div><div>未找到匹配结果</div></div>';
		} else {
			resultsDiv.innerHTML = '<div class="empty-state"><div class="empty-icon">⌨️</div><div>输入关键词开始搜索</div></div>';
		}
		statusText.textContent = '就绪';
		return;
	}
	
	let html = '';
	for (let i = 0; i < results.length; i++) {
		const item = results[i];
		const selectedClass = (i === selectedIndex) ? 'selected' : '';
		html += '<div class="result-item ' + selectedClass + '" data-index="' + i + '">';
		html += '<span class="result-icon">' + renderIcon(item.icon) + '</span>';
		html += '<div class="result-content">';
		html += '<div class="result-name">' + escapeHtml(item.name) + '</div>';
		html += '<div class="result-desc">' + escapeHtml(item.description) + '</div>';
		html += '</div>';
		html += '<span class="result-badge">' + (typeNames[item.type] || item.type || '') + '</span>';
		html += '</div>';
	}
	resultsDiv.innerHTML = html;
	
	document.querySelectorAll('.result-item').forEach(el => {
		el.onclick = async function() {
			selectedIndex = parseInt(this.dataset.index);
			renderResults();
			await executeItem();
		};
	});
	
	const selected = resultsDiv.querySelector('.selected');
	if (selected) selected.scrollIntoView({ block: 'nearest' });
	
	if (totalCount > results.length) {
		statusText.textContent = results.length + '/' + totalCount + ' 个结果';
	} else {
		statusText.textContent = results.length + ' 个结果';
	}
}

async function doSearch() {
	const query = input.value.trim();
	
	try {
		await aardio.debug("JS开始搜索: " + query);
		
		const jsonStr = await aardio.search(query);
		
		await aardio.debug("JS收到数据长度: " + (jsonStr ? jsonStr.length : 0));
		
		if (!jsonStr || jsonStr.length === 0) {
			await aardio.debug("JS收到空数据!");
			results = [];
			totalCount = 0;
		} else {
			try {
				const response = JSON.parse(jsonStr);
				results = response.items || [];
				totalCount = response.total || 0;
				await aardio.debug("JS解析成功，总数: " + totalCount + "，显示: " + results.length);
			} catch(parseErr) {
				await aardio.debug("JS解析JSON失败: " + parseErr.message);
				results = [];
				totalCount = 0;
			}
		}
		
		if (!Array.isArray(results)) results = [];
	} catch(e) {
		await aardio.debug("JS搜索异常: " + e.message);
		console.error('搜索错误:', e);
		results = [];
		totalCount = 0;
	}
	
	selectedIndex = 0;
	renderResults();
}

async function executeItem() {
	if (selectedIndex < 0 || selectedIndex >= results.length) return;
	
	const item = results[selectedIndex];
	
	try {
		const completion = await aardio.execute(JSON.stringify(item));
		
		if (completion && completion.length > 0) {
			input.value = completion;
			input.focus();
			await doSearch();
		} else {
			await aardio.hide();
		}
	} catch(e) {
		console.error('执行错误:', e);
	}
}

input.addEventListener('input', () => {
	clearTimeout(searchTimer);
	searchTimer = setTimeout(() => doSearch(), 80);
});

document.addEventListener('keydown', async (e) => {
	if (e.key === 'ArrowDown') {
		e.preventDefault();
		if (results.length > 0) {
			selectedIndex = (selectedIndex + 1) % results.length;
			renderResults();
		}
	}
	else if (e.key === 'ArrowUp') {
		e.preventDefault();
		if (results.length > 0) {
			selectedIndex = (selectedIndex - 1 + results.length) % results.length;
			renderResults();
		}
	}
	else if (e.key === 'Enter') {
		e.preventDefault();
		await executeItem();
	}
	else if (e.key === 'Tab') {
		e.preventDefault();
		if (results[selectedIndex] && results[selectedIndex].type === 'search_hint') {
			await executeItem();
		}
	}
	else if (e.key === 'Escape') {
		await aardio.hide();
	}
	else if (e.key === ',' && e.ctrlKey) {
		e.preventDefault();
		await aardio.openConfig();
	}
	else if (e.key === 'r' && e.ctrlKey) {
		e.preventDefault();
		await aardio.reloadConfig();
		statusText.textContent = '配置已重载';
		await doSearch();
	}
});

renderResults();
</script>
</body>
</html>
**/

mainForm.center();

//全局热键
var parseHotkey = function(hotkeyStr) {
	var mod = 0;
	var vk = 0;
	
	hotkeyStr = string.lower(hotkeyStr || "alt+r");
	
	//解析修饰键
	if (string.find(hotkeyStr, "ctrl") || string.find(hotkeyStr, "control")) {
		mod = mod | 2/*_MOD_CONTROL*/;
	}
	if (string.find(hotkeyStr, "alt")) {
		mod = mod | 1/*_MOD_ALT*/;
	}
	if (string.find(hotkeyStr, "shift")) {
		mod = mod | 4/*_MOD_SHIFT*/;
	}
	if (string.find(hotkeyStr, "win")) {
		mod = mod | 8/*_MOD_WIN*/;
	}
	
	//解析主键
	var parts = string.split(hotkeyStr, "+");
	if (#parts > 0) {
		var keyStr = string.trim(parts[#parts]);
		keyStr = string.upper(keyStr);
		
		//特殊键
		var specialKeys = {
			space = 0x20/*_VK_SPACE*/;
			enter = 0x0D/*_VK_RETURN*/;
			tab = 0x09/*_VK_TAB*/;
			esc = 0x1B/*_VK_ESCAPE*/;
			escape = 0x1B/*_VK_ESCAPE*/;
			f1 = 0x70; f2 = 0x71; f3 = 0x72; f4 = 0x73;
			f5 = 0x74; f6 = 0x75; f7 = 0x76; f8 = 0x77;
			f9 = 0x78; f10 = 0x79; f11 = 0x7A; f12 = 0x7B;
		};
		
		var lowerKey = string.lower(keyStr);
		if (specialKeys[lowerKey]) {
			vk = specialKeys[lowerKey];
		} elseif (#keyStr == 1) {
			//单个字符，直接转为ASCII
			vk = string.byte(keyStr);
		}
	}
	
	return mod, vk;
};

//全局热键
var hotkeyMod, hotkeyVk = parseHotkey(cfg.hotkey || "Alt+Space");

var hkId = mainForm.reghotkey(function(id, mod, vk) {
	if (mainForm.visible) {
		mainForm.show(false);
	} else {
		mainForm.center();
		mainForm.show();
		win.setForeground(mainForm.hwnd);
		wb.focus();
		wb.doScript(`
			document.getElementById('searchInput').value = '';
			document.getElementById('searchInput').focus();
			results = [];
			selectedIndex = 0;
			renderResults();
		`);
	}
}, hotkeyMod, hotkeyVk);

//失去焦点时隐藏
mainForm.onDeactivate = function() {
	win.setTimeout(function() {
		if (!mainForm.isActive()) {
			mainForm.show(false);
		}
	}, 200);
};

//最小化
import win.util.tray;
mainForm.tray = win.util.tray(mainForm);
mainForm.tray.tip = "Quera";

mainForm.onTrayMessage = {
	[0x205/*_WM_RBUTTONUP*/  ] = function(wParam){ 
		win.setForeground(mainForm.hwnd)
		import win.ui.menu;
		
		mainForm.popmenu = win.ui.popmenu(mainForm);
		mainForm.popmenu.add('&打开',function(id){
			mainForm.show();
			win.region.round(mainForm);
		});
		mainForm.popmenu.add('&目录',function(id){
			process.execute("", ..io.fullpath("/config.ini"));
		});
		mainForm.popmenu.add();//分隔线
		mainForm.popmenu.add('&关闭',function(id){mainForm.close()});		
		mainForm.popmenu.popup();
		mainForm.popmenu.close();
	}
	[0x201/*_WM_LBUTTONDOWN*/] = function(wParam){
		mainForm.show();
		win.region.round(mainForm);
	}
}

//初始化搜索缓存
searcher.buildCache(cfg.search_paths, cfg.file_types);

//启动
mainForm.show(false);
win.loopMessage();