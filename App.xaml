<Application x:Class="Quera.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Quera.Converters"
             xmlns:tb="http://www.hardcodet.net/taskbar">
    <Application.Resources>
        <ResourceDictionary>
            <tb:TaskbarIcon x:Key="TrayIcon"
                            IconSource="pack://application:,,,/icon.ico"
                            ToolTipText="Quera"
                            Visibility="Visible" />
            <converters:TypeToBadgeTextConverter x:Key="TypeToBadgeText"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:IconToImageConverter x:Key="IconToImage"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>